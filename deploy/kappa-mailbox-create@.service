[Unit]
Description=Provision one Kappa mailbox

[Service]
Type=simple
DynamicUser=yes
LoadCredential=stalwart.json:/root/webmail-admin-credentials.json
ExecStart=/usr/bin/python3 -I -B /opt/webmail-service/portal/mailboxes/provision.py
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=25
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
