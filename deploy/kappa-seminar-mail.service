[Unit]
Description=Deliver queued Kappa seminar email
After=network-online.target docker.service

[Service]
Type=oneshot
User=kappa-webmail-portal
Group=kappa-webmail-portal
WorkingDirectory=/opt/webmail-service/portal
EnvironmentFile=/etc/kappa-webmail-portal/portal.env
ExecStart=/opt/webmail-portal-venv/bin/python -B manage.py kappa_seminar_mail
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kappa-webmail-portal
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=256M
